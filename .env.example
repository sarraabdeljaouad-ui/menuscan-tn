# Copier ce fichier en .env et choisir un mot de passe local.
# Le fichier .env est exclu de Git.
POSTGRES_USER=menuscan
POSTGRES_PASSWORD=choisir_un_mot_de_passe
POSTGRES_PORT=5440
# Adresse de l'application client (liens de démonstration, QR codes)
CLIENT_URL=http://localhost:8501
# Airflow (phase 5) : clé qui signe les échanges entre ses conteneurs. Facultative sur ce poste ;
# la remplacer par une chaîne au hasard si le projet sort du poste local.
AIRFLOW_JWT_SECRET=menuscan-poste-local
