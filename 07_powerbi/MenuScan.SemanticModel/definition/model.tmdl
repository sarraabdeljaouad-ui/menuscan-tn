model Model
	culture: fr-FR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_date","dim_heure","dim_etablissement","dim_table","dim_article","dim_formule","dim_canal","dim_ville","fait_session","fait_commande","fait_ligne_commande","fait_abonnement_mensuel","fait_facturation","fait_marketing","fait_prospect","fait_ticket_support","fait_vue_article","Serveur","Base"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_date
ref table dim_heure
ref table dim_etablissement
ref table dim_table
ref table dim_article
ref table dim_formule
ref table dim_canal
ref table dim_ville
ref table fait_session
ref table fait_commande
ref table fait_ligne_commande
ref table fait_abonnement_mensuel
ref table fait_facturation
ref table fait_marketing
ref table fait_prospect
ref table fait_ticket_support
ref table fait_vue_article
ref table 'Pont MRR'
ref table 'Mois écoulés'
ref table 'Étapes commerciales'
ref table 'Étapes de session'
ref table _Mesures

ref role 'Gérant démo'

ref cultureInfo fr-FR

