role 'Gérant démo'
	modelPermission: read

	tablePermission dim_etablissement = dim_etablissement[etablissement_id] = "ETB0003"
	tablePermission dim_article = dim_article[etablissement_id] = "ETB0003"
	tablePermission dim_table = dim_table[etablissement_id] = "ETB0003"
	tablePermission fait_marketing = FALSE ()
	tablePermission fait_prospect = FALSE ()
