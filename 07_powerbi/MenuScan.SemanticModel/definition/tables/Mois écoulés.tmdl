table 'Mois écoulés'

	column libelle
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [libelle]
		sortByColumn: mois

	column mois
		dataType: int64
		summarizeBy: none
		isNameInferred
		sourceColumn: [mois]

	partition 'Mois écoulés' = calculated
		mode: import
		source = DATATABLE ( "libelle", STRING, "mois", INTEGER, { { "M0", 0 }, { "M3", 3 }, { "M6", 6 }, { "M9", 9 }, { "M12", 12 }, { "M18", 18 }, { "M24", 24 } } )
