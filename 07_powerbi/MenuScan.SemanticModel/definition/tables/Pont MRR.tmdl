table 'Pont MRR'

	column etape
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [etape]
		sortByColumn: ordre

	column ordre
		dataType: int64
		summarizeBy: none
		isNameInferred
		sourceColumn: [ordre]

	partition 'Pont MRR' = calculated
		mode: import
		source = DATATABLE ( "etape", STRING, "ordre", INTEGER, { { "MRR de départ", 1 }, { "Nouveaux", 2 }, { "Expansion", 3 }, { "Contraction", 4 }, { "Pertes", 5 } } )
