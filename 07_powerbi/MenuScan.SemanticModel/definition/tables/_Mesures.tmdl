			FORMAT ( CALCULATE ( [CA servi par jour], dim_date[est_ramadan] = FALSE () ), "#,0.0" ) & " → "
				& FORMAT ( CALCULATE ( [CA servi par jour], dim_date[est_ramadan] = TRUE () ), "#,0.0" ) & " DT"
		displayFolder: 9. Saisonnalité
