	measure 'Prix moyen pratiqué' = DIVIDE ( SUM ( fait_ligne_commande[montant_ligne_ttc] ), SUM ( fait_ligne_commande[quantite] ) )
		formatString: #,0.000
		displayFolder: 8. Menu et marge

	measure 'Hausse de prix' = ```
			VAR p = SELECTEDVALUE ( dim_article[prix_precedent] )
			RETURN
				IF (
					NOT ISBLANK ( [Fenêtre (jours)] ),
					DIVIDE ( SELECTEDVALUE ( dim_article[prix_ttc] ) - p, p )
				)
			```
		formatString: +0.0 %;-0.0 %
		displayFolder: 8. Menu et marge

	measure 'Fenêtre brute (jours)' = ```
			VAR d = SELECTEDVALUE ( dim_article[valide_du] )
			VAR prec = SELECTEDVALUE ( dim_article[debut_version_precedente] )
			VAR arrete = CALCULATE ( MAX ( dim_date[date] ), REMOVEFILTERS ( dim_date ) )
			VAR fin = COALESCE ( SELECTEDVALUE ( dim_article[valide_au] ), arrete )
			RETURN
				IF (
					HASONEVALUE ( dim_article[prix_id] ) && NOT ISBLANK ( prec )
						&& SELECTEDVALUE ( dim_article[etablissement_id] ) IN VALUES ( dim_etablissement[etablissement_id] ),
					VAR w = MIN ( 60, MIN ( DATEDIFF ( prec, d, DAY ), DATEDIFF ( d, fin, DAY ) + 1 ) )
					RETURN IF ( w >= 14, w )
				)
			```
		formatString: 0
		displayFolder: 8. Menu et marge

	measure 'Quantités avant le changement' = ```
			VAR d = SELECTEDVALUE ( dim_article[valide_du] )
			VAR w = [Fenêtre brute (jours)]
			VAR a = SELECTEDVALUE ( dim_article[article_id] )
			RETURN
				IF (
					NOT ISBLANK ( w ),
					CALCULATE (
						[Quantités servies] + 0,
						REMOVEFILTERS ( dim_article ),
						dim_article[article_id] = a,
						REMOVEFILTERS ( dim_date ),
						FILTER ( ALL ( dim_date[date] ), dim_date[date] >= d - w && dim_date[date] < d )
					)
				)
			```
		formatString: #,0
		displayFolder: 8. Menu et marge

	measure 'Quantités après le changement' = ```
			VAR d = SELECTEDVALUE ( dim_article[valide_du] )
			VAR w = [Fenêtre brute (jours)]
			VAR a = SELECTEDVALUE ( dim_article[article_id] )
			RETURN
				IF (
					NOT ISBLANK ( w ),
					CALCULATE (
						[Quantités servies] + 0,
						REMOVEFILTERS ( dim_article ),
						dim_article[article_id] = a,
						REMOVEFILTERS ( dim_date ),
						FILTER ( ALL ( dim_date[date] ), dim_date[date] >= d && dim_date[date] < d + w )
					)
				)
			```
		formatString: #,0
		displayFolder: 8. Menu et marge

	measure 'Fenêtre (jours)' = ```
			VAR w = [Fenêtre brute (jours)]
			RETURN
				IF ( NOT ISBLANK ( w ) && [Quantités avant le changement] + [Quantités après le changement] > 0, w )
			```
		formatString: 0
		displayFolder: 8. Menu et marge

	measure 'Prix avant → après' = ```
			IF (
				NOT ISBLANK ( [Hausse de prix] ),
				FORMAT ( SELECTEDVALUE ( dim_article[prix_precedent] ), "0.000" ) & " → " & FORMAT ( SELECTEDVALUE ( dim_article[prix_ttc] ), "0.000" )
			)
			```
		displayFolder: 8. Menu et marge

	measure 'Quantités avant → après' = ```
			IF (
				NOT ISBLANK ( [Fenêtre (jours)] ),
				FORMAT ( [Quantités avant le changement], "0" ) & " → " & FORMAT ( [Quantités après le changement], "0" )
			)
			```
		displayFolder: 8. Menu et marge

	measure 'Écart des quantités' = ```
			VAR av = [Quantités avant le changement]
			RETURN IF ( av > 0, DIVIDE ( [Quantités après le changement] - av, av ) )
			```
		formatString: +0 %;-0 %
		displayFolder: 8. Menu et marge

	measure 'Changements de prix' = ```
			CALCULATE (
				COUNTROWS ( dim_article ),
				dim_article[motif_changement] <> "creation",
				NOT ISBLANK ( dim_article[prix_precedent] ),
				TREATAS ( VALUES ( dim_etablissement[etablissement_id] ), dim_article[etablissement_id] ),
				TREATAS ( VALUES ( dim_date[date] ), dim_article[valide_du] )
			)
			```
		formatString: #,0
		displayFolder: 8. Menu et marge

	measure 'Hausse moyenne' = ```
			VAR lignes =
				CALCULATETABLE (
					dim_article,
					dim_article[motif_changement] <> "creation",
					NOT ISBLANK ( dim_article[prix_precedent] ),
					TREATAS ( VALUES ( dim_etablissement[etablissement_id] ), dim_article[etablissement_id] ),
					TREATAS ( VALUES ( dim_date[date] ), dim_article[valide_du] )
				)
			RETURN AVERAGEX ( lignes, DIVIDE ( dim_article[prix_ttc] - dim_article[prix_precedent], dim_article[prix_precedent] ) )
			```
		formatString: +0.0 %;-0.0 %
		displayFolder: 8. Menu et marge

	measure 'Texte changements' = FORMAT ( [Changements de prix], "#,0" )
		displayFolder: 8. Menu et marge

	measure 'Texte changements détail' = "révisions et repositionnements sur la période"
		displayFolder: 8. Menu et marge

	measure 'Texte hausse' = FORMAT ( [Hausse moyenne], "+0.0 %;-0.0 %" )
		displayFolder: 8. Menu et marge

	measure 'Texte hausse détail' = "moyenne simple des " & FORMAT ( [Changements de prix], "0" ) & " changements"
		displayFolder: 8. Menu et marge

	measure 'Texte sensibilité détail' = "modèle de la phase 7 (EF-11)"
		displayFolder: 8. Menu et marge

	measure 'Titre prix et quantités' = "Prix et quantités par article : " & IF ( HASONEVALUE ( dim_article[nom_article] ), SELECTEDVALUE ( dim_article[nom_article] ), "choisir un article" )
		displayFolder: 8. Menu et marge

	measure 'Recette valeur' = ```
			SWITCH (
				SELECTEDVALUE ( Recette[code] ),
				"R01", [K01 Établissements actifs],
				"R02", [K02 MRR],
				"R03", CALCULATE ( [K02 MRR], dim_date[annee] = 2025 ),
				"R04", [K03 ARR],
				"R05", CALCULATE ( [K04 MRR nouveau], dim_date[annee] = 2026 ),
				"R06", CALCULATE ( [K04 MRR expansion], dim_date[annee] = 2026 ),
				"R07", CALCULATE ( [K04 MRR contraction], dim_date[annee] = 2026 ),
				"R08", CALCULATE ( [K04 MRR perdu], dim_date[annee] = 2026 ),
				"R09", CALCULATE ( [Résiliations], dim_date[annee] = 2026 ),
				"R10", CALCULATE ( [K05 Taux de résiliation mensuel], dim_date[annee] = 2026 ),
				"R11", CALCULATE ( [K06 Rétention de cohorte], 'Mois écoulés'[mois] = 12, dim_etablissement[trimestre_cohorte] = "T1 2025" ),
				"R12", [K07 Taux de conversion des prospects],
				"R13", [K08 Délai de signature médian],
				"R14", CALCULATE ( [K09 CAC], dim_canal[nom_canal] = "Parrainage" ),
				"R15", CALCULATE ( [K09 CAC], dim_canal[nom_canal] = "Salons professionnels" ),
				"R16", CALCULATE ( [K10 Valeur vie client], dim_date[annee] = 2026 ),
				"R17", CALCULATE ( [K11 Coût par clic], dim_date[annee] = 2026 ),
				"R18", CALCULATE ( [K11 Taux de clic], dim_date[annee] = 2026 ),
				"R19", CALCULATE ( [K12 Sessions par table et par jour], dim_date[annee] = 2026 ),
				"R20", CALCULATE ( [K13 Taux de commande], dim_formule[nom_formule] = "Commande" ),
				"R21", CALCULATE ( [K13 Taux de commande], dim_formule[nom_formule] = "Pro" ),
				"R22", [K14 Panier moyen],
				"R23", [K15 Taux d'annulation],
				"R24", CALCULATE ( [Commandes], dim_date[annee] = 2026 ),
				"R25", CALCULATE ( [CA commandes servies TTC], dim_date[annee] = 2026 ),
				"R26", CALCULATE ( [K16 Facturé HT], dim_date[annee] = 2026 ),
				"R27", CALCULATE ( [K16 Encaissé TTC], dim_date[annee] = 2026 ),
				"R28", CALCULATE ( [K17 Taux de factures payées en retard], dim_date[annee] = 2026 ),
				"R29", CALCULATE ( [K17 Factures impayées], dim_date[annee] = 2026 ),
				"R30", [K18 Délai de résolution médian (h)],
				"R31", [K18 Satisfaction moyenne],
				"R32", CALCULATE ( [K20 Étape 1 Article consulté], dim_formule[nom_formule] = "Commande" ),
				"R33", CALCULATE ( [K20 Étape 2 Panier], dim_formule[nom_formule] = "Commande" ),
				"R34", CALCULATE ( [K21 Marge brute estimée TTC], dim_date[annee] = 2026 ),
				"R35", CALCULATE ( [K21 Taux de coût estimé], dim_date[annee] = 2026 ),
				"R36", CALCULATE ( [K22 Nombre de vedettes], dim_date[annee] = 2026 ),
				"R37", CALCULATE ( [K22 Nombre de chevaux de labour], dim_date[annee] = 2026 ),
				"R38", CALCULATE ( [K22 Nombre d'énigmes], dim_date[annee] = 2026 ),
				"R39", CALCULATE ( [K22 Nombre de poids morts], dim_date[annee] = 2026 ),
				"R40", [K23 Part du soir en Ramadan],
				"R41", [K23 Part du soir hors Ramadan]
			)
			```
		formatString: #,0.0000
		displayFolder: 10. Recette

	measure 'Recette attendu' = SELECTEDVALUE ( Recette[attendu] )
		formatString: #,0.0000
		displayFolder: 10. Recette

	measure 'Recette écart' = IF ( HASONEVALUE ( Recette[code] ), [Recette valeur] - [Recette attendu] )
		formatString: #,0.0000
		displayFolder: 10. Recette

	measure 'Recette statut' = ```
			VAR v = [Recette valeur]
			RETURN
				IF (
					HASONEVALUE ( Recette[code] ),
					IF ( ISBLANK ( v ), "ABSENT", IF ( ABS ( v - [Recette attendu] ) <= SELECTEDVALUE ( Recette[tolerance] ) + 1E-9, "OK", "ÉCART" ) )
				)
			```
		displayFolder: 10. Recette

	measure 'Couleur statut' = SWITCH ( [Recette statut], "OK", "#DCFCE7", "ÉCART", "#FEE2E2", "ABSENT", "#FEF3C7" )
		displayFolder: 10. Recette

	measure 'Texte recette' = ```
			VAR ok = COUNTROWS ( FILTER ( VALUES ( Recette[code] ), [Recette statut] = "OK" ) )
			RETURN FORMAT ( ok, "0" ) & " / " & FORMAT ( COUNTROWS ( Recette ), "0" ) & " contrôles conformes"
			```
		displayFolder: 10. Recette

	measure 'Texte recette détail' = "valeurs attendues calculées en SQL sur menuscan_dwh le 26/11/2026"
		displayFolder: 10. Recette

	column Value
		isHidden
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition '_Mesures' = calculated
		mode: import
		source = {BLANK()}
