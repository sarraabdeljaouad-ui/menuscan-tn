	measure 'Texte commandes par jour détail' =
			"hors Ramadan → Ramadan ("
				& FORMAT ( DIVIDE ( [K23 Commandes par jour en Ramadan], [K23 Commandes par jour hors Ramadan] ) - 1, "+0 %;-0 %" ) & ")"
		displayFolder: 9. Saisonnalité
