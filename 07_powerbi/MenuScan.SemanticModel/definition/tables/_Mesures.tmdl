	measure 'Commandes de l''article' = CALCULATE ( DISTINCTCOUNT ( fait_ligne_commande[commande_id] ), fait_ligne_commande[est_servie] = TRUE () )
		formatString: #,0
		displayFolder: 8. Menu et marge

	measure 'Conversion de la fiche' = DIVIDE ( [Commandes de l'article], [Vues de fiche] )
		formatString: 0.0 %
		displayFolder: 8. Menu et marge

	measure 'Prix TTC actuel' = ```
			CALCULATE (
				MAX ( dim_article[prix_ttc] ),
				dim_article[est_prix_actuel] = TRUE (),
				TREATAS ( VALUES ( dim_etablissement[etablissement_id] ), dim_article[etablissement_id] )
			)
			```
		formatString: #,0.000
		displayFolder: 8. Menu et marge

	measure 'Couleur article' = ```
			VAR arts = ALLSELECTED ( dim_article[nom_article] )
			VAR vues_moy = AVERAGEX ( arts, [Vues de fiche] )
			VAR conv_moy = DIVIDE ( SUMX ( arts, [Commandes de l'article] ), SUMX ( arts, [Vues de fiche] ) )
			RETURN IF ( [Vues de fiche] >= vues_moy && [Conversion de la fiche] < conv_moy, "#C2410C", "#1D4ED8" )
			```
		displayFolder: 8. Menu et marge

	measure 'Étapes de session valeur' = ```
			SWITCH (
				SELECTEDVALUE ( 'Étapes de session'[ordre] ),
