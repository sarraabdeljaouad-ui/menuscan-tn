	measure 'Couleur article' =
			VAR arts = ALLSELECTED ( dim_article[nom_article] )
			VAR vues_moy = AVERAGEX ( arts, [Vues de fiche] )
			VAR conv_moy = DIVIDE ( SUMX ( arts, [Commandes de l'article] ), SUMX ( arts, [Vues de fiche] ) )
			RETURN IF ( [Vues de fiche] >= vues_moy && [Conversion de la fiche] < conv_moy, "#C2410C", "#1D4ED8" )
		displayFolder: 8. Menu et marge
		lineageTag: 9330137f-7b25-4c89-aa64-7cf7ffb71256

