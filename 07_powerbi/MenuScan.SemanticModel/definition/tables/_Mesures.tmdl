	measure 'K02 MRR A-1' =
			VAR m = EDATE ( MAX ( dim_date[premier_jour_mois] ), -12 )
			RETURN
				CALCULATE ( SUM ( fait_abonnement_mensuel[mrr_ht] ), REMOVEFILTERS ( dim_date ), dim_date[premier_jour_mois] = m )
