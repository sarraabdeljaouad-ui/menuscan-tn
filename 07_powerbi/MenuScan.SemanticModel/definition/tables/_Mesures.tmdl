	measure 'Heure de pointe hors Ramadan' =
			VAR h = CALCULATETABLE ( VALUES ( dim_heure[heure] ), REMOVEFILTERS ( dim_heure ) )
			VAR pic = TOPN ( 1, h, CALCULATE ( [Commandes servies], dim_date[est_ramadan] = FALSE () ), DESC )
			RETURN CONCATENATEX ( pic, FORMAT ( dim_heure[heure], "0" ) & " h", ", " )
		displayFolder: 9. Saisonnalité
		lineageTag: 8502b91b-2b4c-4c6c-81b2-61fd332b0512

