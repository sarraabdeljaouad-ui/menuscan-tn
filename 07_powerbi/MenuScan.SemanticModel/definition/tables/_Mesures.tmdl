	measure 'Texte été' =
			VAR e = CALCULATE ( [Commandes servies par jour], dim_date[periode_activite] = "ete" )
			VAR n = CALCULATE ( [Commandes servies par jour], dim_date[periode_activite] = "normale" )
			RETURN
				"Été : " & FORMAT ( e, "#,0.00" ) & " commandes par jour · période normale : " & FORMAT ( n, "#,0.00" )
					& " (" & FORMAT ( DIVIDE ( e, n ) - 1, "+0 %;-0 %" ) & ")"
		displayFolder: 9. Saisonnalité
		lineageTag: 0a0661c9-0dc7-467f-b264-e9c084cc402e

	measure 'Prix moyen pratiqué' = DIVIDE ( SUM ( fait_ligne_commande[montant_ligne_ttc] ), SUM ( fait_ligne_commande[quantite] ) )
		formatString: #,0.000
		displayFolder: 8. Menu et marge
		lineageTag: de8cecf8-14a2-4ac5-9d89-5d830529dbaa

	measure 'Hausse de prix' =
			VAR p = SELECTEDVALUE ( dim_article[prix_precedent] )
			RETURN
				IF (
					HASONEVALUE ( dim_article[prix_id] ) && NOT ISBLANK ( p ),
					DIVIDE ( SELECTEDVALUE ( dim_article[prix_ttc] ) - p, p )
				)
		formatString: +0.0 %;-0.0 %
		displayFolder: 8. Menu et marge
		lineageTag: 136a700f-f449-416c-ba96-97edd4c9be59

	measure 'Fenêtre (jours)' =
			VAR d = SELECTEDVALUE ( dim_article[valide_du] )
			VAR prec = SELECTEDVALUE ( dim_article[debut_version_precedente] )
			VAR arrete = CALCULATE ( MAX ( dim_date[date] ), REMOVEFILTERS ( dim_date ) )
			VAR fin = COALESCE ( SELECTEDVALUE ( dim_article[valide_au] ), arrete )
			RETURN
				IF (
					HASONEVALUE ( dim_article[prix_id] ) && NOT ISBLANK ( prec ),
					MIN ( 30, MIN ( DATEDIFF ( prec, d, DAY ), DATEDIFF ( d, fin, DAY ) + 1 ) )
				)
		formatString: 0
		displayFolder: 8. Menu et marge
		lineageTag: 2d2de3df-d59f-4354-8c33-a5add24d7307

	measure 'Quantités avant le changement' =
			VAR d = SELECTEDVALUE ( dim_article[valide_du] )
			VAR w = [Fenêtre (jours)]
			VAR a = SELECTEDVALUE ( dim_article[article_id] )
			RETURN
				IF (
					NOT ISBLANK ( w ),
					CALCULATE (
						[Quantités servies] + 0,
						REMOVEFILTERS ( dim_article ),
						dim_article[article_id] = a,
						REMOVEFILTERS ( dim_date ),
						FILTER ( ALL ( dim_date[date] ), dim_date[date] >= d - w && dim_date[date] < d )
					)
				)
		formatString: #,0
		displayFolder: 8. Menu et marge
		lineageTag: 107630ac-01fe-4869-8b1c-e35fbca33c69

	measure 'Quantités après le changement' =
			VAR d = SELECTEDVALUE ( dim_article[valide_du] )
			VAR w = [Fenêtre (jours)]
			VAR a = SELECTEDVALUE ( dim_article[article_id] )
			RETURN
				IF (
					NOT ISBLANK ( w ),
					CALCULATE (
						[Quantités servies] + 0,
						REMOVEFILTERS ( dim_article ),
						dim_article[article_id] = a,
						REMOVEFILTERS ( dim_date ),
						FILTER ( ALL ( dim_date[date] ), dim_date[date] >= d && dim_date[date] < d + w )
					)
				)
		formatString: #,0
		displayFolder: 8. Menu et marge
		lineageTag: 74510ab2-b5eb-4eef-b545-a5882188e493

	measure 'Prix avant → après' =
			IF (
				NOT ISBLANK ( [Hausse de prix] ),
				FORMAT ( SELECTEDVALUE ( dim_article[prix_precedent] ), "0.000" ) & " → " & FORMAT ( SELECTEDVALUE ( dim_article[prix_ttc] ), "0.000" )
			)
		displayFolder: 8. Menu et marge
		lineageTag: d06819dd-d14b-4943-8b67-baefac954870

	measure 'Quantités avant → après' =
			IF (
				NOT ISBLANK ( [Fenêtre (jours)] ),
				FORMAT ( [Quantités avant le changement], "0" ) & " → " & FORMAT ( [Quantités après le changement], "0" )
			)
		displayFolder: 8. Menu et marge
		lineageTag: 35af9547-0332-420b-a3a9-65d3f0e028dc

	measure 'Écart des quantités' =
			VAR av = [Quantités avant le changement]
			RETURN IF ( av > 0, DIVIDE ( [Quantités après le changement] - av, av ) )
		formatString: +0 %;-0 %
		displayFolder: 8. Menu et marge
		lineageTag: 861bdc12-0de3-45df-a998-f24ab3c425c0

	measure 'Changements de prix' =
			CALCULATE (
				COUNTROWS ( dim_article ),
				dim_article[motif_changement] <> "creation",
				NOT ISBLANK ( dim_article[prix_precedent] ),
				TREATAS ( VALUES ( dim_etablissement[etablissement_id] ), dim_article[etablissement_id] ),
				TREATAS ( VALUES ( dim_date[date] ), dim_article[valide_du] )
			)
		formatString: #,0
		displayFolder: 8. Menu et marge
		lineageTag: 477706c3-c057-49a8-b2cc-ac64146e6306

	measure 'Hausse moyenne' =
			VAR lignes =
				CALCULATETABLE (
					dim_article,
					dim_article[motif_changement] <> "creation",
					NOT ISBLANK ( dim_article[prix_precedent] ),
					TREATAS ( VALUES ( dim_etablissement[etablissement_id] ), dim_article[etablissement_id] ),
					TREATAS ( VALUES ( dim_date[date] ), dim_article[valide_du] )
				)
			RETURN AVERAGEX ( lignes, DIVIDE ( dim_article[prix_ttc] - dim_article[prix_precedent], dim_article[prix_precedent] ) )
		formatString: +0.0 %;-0.0 %
		displayFolder: 8. Menu et marge
		lineageTag: 8ac3ac7f-100b-4a4e-b08f-037ff31a308d

	measure 'Texte changements' = FORMAT ( [Changements de prix], "#,0" )
		displayFolder: 8. Menu et marge
		lineageTag: 29720dcd-124d-432e-ba90-3a6da5c4652c

	measure 'Texte changements détail' = "révisions et repositionnements sur la période"
