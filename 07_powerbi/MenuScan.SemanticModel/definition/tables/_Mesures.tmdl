			VAR p = CALCULATE ( [K17 Taux de factures payées en retard], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			RETURN
				FORMAT ( [K17 Factures impayées], "#,0" ) & " impayées · A-1 : " & IF ( ISBLANK ( p ), "n. d.", FORMAT ( p, "0.0 %" ) )
		displayFolder: 1. Croissance
