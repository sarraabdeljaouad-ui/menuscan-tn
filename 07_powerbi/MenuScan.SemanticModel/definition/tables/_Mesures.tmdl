			VAR pic = TOPN ( 1, h, CALCULATE ( [Commandes servies], dim_date[est_ramadan] = FALSE () ), DESC )
			RETURN FORMAT ( CALCULATE ( [Commandes servies], pic, dim_date[est_ramadan] = FALSE () ), "#,0" ) & " commandes servies à cette heure"
