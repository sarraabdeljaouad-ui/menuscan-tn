				2, CALCULATE ( [Sessions], KEEPFILTERS ( dim_formule[inclut_commande] = TRUE () ), fait_session[a_ajoute_panier] = TRUE () ),
				3, CALCULATE ( [Sessions], KEEPFILTERS ( dim_formule[inclut_commande] = TRUE () ), fait_session[a_commande] = TRUE () )
			)
			```
		formatString: #,0
