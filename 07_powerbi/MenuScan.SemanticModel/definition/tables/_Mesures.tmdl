table '_Mesures'

	measure Sessions = COUNTROWS ( fait_session )
		formatString: #,0
		displayFolder: 0. Bases

	measure Commandes = COUNTROWS ( fait_commande )
		formatString: #,0
		displayFolder: 0. Bases

	measure 'Commandes servies' = CALCULATE ( COUNTROWS ( fait_commande ), fait_commande[est_servie] = TRUE () )
		formatString: #,0
		displayFolder: 0. Bases

	measure 'CA commandes servies TTC' = CALCULATE ( SUM ( fait_commande[montant_total_ttc] ), fait_commande[est_servie] = TRUE () )
		formatString: #,0
		displayFolder: 0. Bases

	measure 'Commandes servies par jour' = DIVIDE ( [Commandes servies], COUNTROWS ( dim_date ) )
		formatString: #,0.0
		displayFolder: 0. Bases

	measure Prospects = COUNTROWS ( fait_prospect )
		formatString: #,0
		displayFolder: 0. Bases

	measure 'Dépenses marketing TTC' = SUM ( fait_marketing[depense_ttc] )
		formatString: #,0
		displayFolder: 0. Bases

	measure 'K01 Établissements actifs' = ```
			VAR m = MAX ( dim_date[premier_jour_mois] )
			RETURN
				CALCULATE (
					COUNTROWS ( fait_abonnement_mensuel ),
					fait_abonnement_mensuel[est_abonne] = TRUE (),
					REMOVEFILTERS ( dim_date ),
					dim_date[premier_jour_mois] = m
				)
			```
		formatString: #,0
		displayFolder: 1. Croissance

	measure 'K02 MRR' = ```
			VAR m = MAX ( dim_date[premier_jour_mois] )
			VAR r =
				CALCULATE (
					SUM ( fait_abonnement_mensuel[mrr_ht] ),
					REMOVEFILTERS ( dim_date ),
					dim_date[premier_jour_mois] = m
				)
			RETURN
				IF ( r <> 0, r )
			```
		formatString: #,0
		displayFolder: 1. Croissance

	measure 'K03 ARR' = 12 * [K02 MRR]
		formatString: #,0
		displayFolder: 1. Croissance

	measure 'K04 MRR nouveau' = SUM ( fait_abonnement_mensuel[mrr_nouveau_ht] )
		formatString: #,0
		displayFolder: 1. Croissance

	measure 'K04 MRR expansion' = SUM ( fait_abonnement_mensuel[mrr_expansion_ht] )
		formatString: #,0
		displayFolder: 1. Croissance

	measure 'K04 MRR contraction' = SUM ( fait_abonnement_mensuel[mrr_contraction_ht] )
		formatString: #,0
		displayFolder: 1. Croissance

	measure 'K04 MRR perdu' = SUM ( fait_abonnement_mensuel[mrr_resiliation_ht] )
		formatString: #,0
		displayFolder: 1. Croissance

	measure 'K04 Variation nette du MRR' = SUM ( fait_abonnement_mensuel[variation_ht] )
		formatString: #,0
		displayFolder: 1. Croissance

	measure 'Résiliations' = ```
			VAR d1 = MIN ( dim_date[date] )
			VAR d2 = MAX ( dim_date[date] )
			RETURN
				COUNTROWS (
					FILTER (
						dim_etablissement,
						dim_etablissement[date_resiliation] >= d1
							&& dim_etablissement[date_resiliation] <= d2
					)
				)
			```
		formatString: #,0
		displayFolder: 2. Rétention

	measure 'K05 Taux de résiliation mensuel' = ```
			VAR mois = VALUES ( dim_date[premier_jour_mois] )
			VAR resiliations =
				SUMX (
					mois,
					VAR d = dim_date[premier_jour_mois]
					RETURN
						COUNTROWS (
							FILTER (
								dim_etablissement,
								dim_etablissement[date_resiliation] >= d
									&& dim_etablissement[date_resiliation] < EDATE ( d, 1 )
							)
						)
				)
			VAR actifs_debut =
				SUMX (
					mois,
					VAR d = dim_date[premier_jour_mois]
					RETURN
						COUNTROWS (
							FILTER (
								dim_etablissement,
								dim_etablissement[date_mise_en_service] < d
									&& ( ISBLANK ( dim_etablissement[date_resiliation] )
										|| dim_etablissement[date_resiliation] >= d )
							)
						)
				)
			RETURN
				DIVIDE ( resiliations, actifs_debut )
			```
		formatString: 0.00 %
		displayFolder: 2. Rétention

	measure 'K07 Taux de conversion des prospects' = ```
			DIVIDE (
				CALCULATE ( COUNTROWS ( fait_prospect ), fait_prospect[est_converti] = TRUE () ),
				[Prospects]
			)
			```
		formatString: 0.0 %
		displayFolder: 3. Acquisition

	measure 'K08 Délai de signature médian' = CALCULATE ( MEDIAN ( fait_prospect[delai_conversion_jours] ), fait_prospect[est_converti] = TRUE () )
		formatString: #,0
		displayFolder: 3. Acquisition

	measure Signatures = ```
			CALCULATE (
				COUNTROWS ( fait_prospect ),
				fait_prospect[est_converti] = TRUE (),
				REMOVEFILTERS ( dim_date ),
				TREATAS ( VALUES ( dim_date[date] ), fait_prospect[date_conversion] )
			)
			```
		formatString: #,0
		displayFolder: 3. Acquisition

	measure 'K09 CAC' = DIVIDE ( [Dépenses marketing TTC], [Signatures] )
		formatString: #,0.0
		displayFolder: 3. Acquisition

	measure 'Revenu mensuel moyen par établissement' = ```
			DIVIDE (
				CALCULATE ( SUM ( fait_abonnement_mensuel[mrr_ht] ), fait_abonnement_mensuel[est_abonne] = TRUE () ),
				CALCULATE ( COUNTROWS ( fait_abonnement_mensuel ), fait_abonnement_mensuel[est_abonne] = TRUE () )
			)
			```
		formatString: #,0.00
		displayFolder: 3. Acquisition

	measure 'K10 Valeur vie client' = DIVIDE ( [Revenu mensuel moyen par établissement], [K05 Taux de résiliation mensuel] )
		formatString: #,0
		displayFolder: 3. Acquisition

	measure 'K11 Coût par clic' = ```
			CALCULATE (
				DIVIDE ( SUM ( fait_marketing[depense_ttc] ), SUM ( fait_marketing[clics] ) ),
				KEEPFILTERS ( dim_canal[type_canal] = "en_ligne" )
			)
			```
		formatString: #,0.000
		displayFolder: 3. Acquisition

	measure 'K11 Taux de clic' = ```
			CALCULATE (
				DIVIDE ( SUM ( fait_marketing[clics] ), SUM ( fait_marketing[impressions] ) ),
				KEEPFILTERS ( dim_canal[type_canal] = "en_ligne" )
			)
			```
		formatString: 0.00 %
		displayFolder: 3. Acquisition

	measure 'K12 Sessions par table et par jour' = ```
			VAR d1 = MIN ( dim_date[date] )
			VAR d2 = MAX ( dim_date[date] )
			VAR tables_jours =
				SUMX (
					dim_etablissement,
					VAR debut = MAX ( d1, dim_etablissement[date_mise_en_service] )
					VAR fin =
						MIN (
							d2,
							IF (
								ISBLANK ( dim_etablissement[date_resiliation] ),
								d2,
								dim_etablissement[date_resiliation]
							)
						)
					RETURN
						IF ( fin >= debut, ( DATEDIFF ( debut, fin, DAY ) + 1 ) * dim_etablissement[nb_tables] )
				)
			RETURN
				DIVIDE ( [Sessions], tables_jours )
			```
		formatString: #,0.000
		displayFolder: 4. Usage

	measure 'K13 Taux de commande' = ```
			DIVIDE (
				CALCULATE (
					COUNTROWS ( fait_session ),
					fait_session[a_commande] = TRUE (),
					KEEPFILTERS ( dim_formule[inclut_commande] = TRUE () )
				),
				CALCULATE ( COUNTROWS ( fait_session ), KEEPFILTERS ( dim_formule[inclut_commande] = TRUE () ) )
			)
			```
		formatString: 0.0 %
		displayFolder: 4. Usage

	measure 'K20 Étape 1 Article consulté' = DIVIDE ( CALCULATE ( COUNTROWS ( fait_session ), fait_session[a_vu_article] = TRUE () ), [Sessions] )
		formatString: 0.0 %
		displayFolder: 4. Usage

	measure 'K20 Étape 2 Panier' = ```
			DIVIDE (
				CALCULATE (
					COUNTROWS ( fait_session ),
					fait_session[a_ajoute_panier] = TRUE (),
					KEEPFILTERS ( dim_formule[inclut_commande] = TRUE () )
				),
				CALCULATE ( COUNTROWS ( fait_session ), KEEPFILTERS ( dim_formule[inclut_commande] = TRUE () ) )
			)
			```
		formatString: 0.0 %
		displayFolder: 4. Usage

	measure 'K20 Étape 3 Commande' = [K13 Taux de commande]
		formatString: 0.0 %
		displayFolder: 4. Usage

	measure 'K14 Panier moyen' = DIVIDE ( [CA commandes servies TTC], [Commandes servies] )
		formatString: #,0.00
		displayFolder: 5. Activité en salle

	measure 'K15 Taux d''annulation' = DIVIDE ( CALCULATE ( COUNTROWS ( fait_commande ), fait_commande[statut_commande] = "annulee" ), [Commandes] )
		formatString: 0.00 %
		displayFolder: 5. Activité en salle

	measure 'K16 Facturé HT' = SUM ( fait_facturation[montant_net_ht] )
		formatString: #,0
		displayFolder: 6. Facturation

	measure 'K16 Encaissé TTC' = SUM ( fait_facturation[montant_encaisse_ttc] )
		formatString: #,0
		displayFolder: 6. Facturation

	measure 'K17 Taux de factures payées en retard' = ```
			DIVIDE (
				CALCULATE ( COUNTROWS ( fait_facturation ), fait_facturation[statut_facture] = "payee_en_retard" ),
				CALCULATE ( COUNTROWS ( fait_facturation ), fait_facturation[montant_ttc] > 0 )
			)
			```
		formatString: 0.0 %
		displayFolder: 6. Facturation

	measure 'K17 Factures impayées' = CALCULATE ( COUNTROWS ( fait_facturation ), fait_facturation[statut_facture] = "impayee" )
		formatString: #,0
		displayFolder: 6. Facturation

	measure 'K18 Délai de résolution médian (h)' = CALCULATE ( MEDIAN ( fait_ticket_support[delai_resolution_heures] ), fait_ticket_support[statut_ticket] = "resolu" )
		formatString: #,0.0
		displayFolder: 7. Support

	measure 'K18 Satisfaction moyenne' = CALCULATE ( AVERAGE ( fait_ticket_support[note_satisfaction] ), fait_ticket_support[statut_ticket] = "resolu" )
		formatString: 0.00
		displayFolder: 7. Support

	measure 'Quantités servies' = CALCULATE ( SUM ( fait_ligne_commande[quantite] ), fait_ligne_commande[est_servie] = TRUE () )
		formatString: #,0
		displayFolder: 8. Menu et marge

	measure 'Ventes servies TTC (lignes)' = CALCULATE ( SUM ( fait_ligne_commande[montant_ligne_ttc] ), fait_ligne_commande[est_servie] = TRUE () )
		formatString: #,0
		displayFolder: 8. Menu et marge

	measure 'K21 Marge brute estimée TTC' = CALCULATE ( SUM ( fait_ligne_commande[marge_brute_estimee_ttc] ), fait_ligne_commande[est_servie] = TRUE () )
		formatString: #,0
		displayFolder: 8. Menu et marge

	measure 'K21 Taux de coût estimé' = ```
			DIVIDE (
				CALCULATE ( SUM ( fait_ligne_commande[cout_matiere_estime_ttc] ), fait_ligne_commande[est_servie] = TRUE () ),
				[Ventes servies TTC (lignes)]
			)
			```
		formatString: 0.0 %
		displayFolder: 8. Menu et marge

	measure 'K22 Marge unitaire estimée' = DIVIDE ( [K21 Marge brute estimée TTC], [Quantités servies] )
		formatString: #,0.000
		displayFolder: 8. Menu et marge

	measure 'K22 Classe du plat' = ```
			VAR q = [Quantités servies]
			VAR etab = VALUES ( dim_article[etablissement_id] )
			VAR q_etab =
				CALCULATE ( [Quantités servies], REMOVEFILTERS ( dim_article ), dim_article[etablissement_id] IN etab )
			VAR marge_etab =
				CALCULATE ( [K21 Marge brute estimée TTC], REMOVEFILTERS ( dim_article ), dim_article[etablissement_id] IN etab )
			VAR nb_plats =
				CALCULATE (
					COUNTROWS ( FILTER ( VALUES ( dim_article[article_id] ), [Quantités servies] > 0 ) ),
					REMOVEFILTERS ( dim_article ),
					dim_article[etablissement_id] IN etab
				)
			VAR populaire = DIVIDE ( q, q_etab ) >= 0.7 / nb_plats
			VAR rentable = DIVIDE ( [K21 Marge brute estimée TTC], q ) >= DIVIDE ( marge_etab, q_etab )
			RETURN
				IF (
					HASONEVALUE ( dim_article[article_id] ) && q > 0,
					SWITCH (
						TRUE (),
						populaire && rentable, "Vedette",
						populaire, "Cheval de labour",
						rentable, "Énigme",
						"Poids mort"
					)
				)
			```
		displayFolder: 8. Menu et marge

	measure 'K22 Nombre de vedettes' = ```
			COUNTROWS (
				FILTER (
					FILTER ( VALUES ( dim_article[article_id] ), [Quantités servies] > 0 ),
					[K22 Classe du plat] = "Vedette"
				)
			)
			```
		formatString: #,0
		displayFolder: 8. Menu et marge

	measure 'K22 Nombre de chevaux de labour' = ```
			COUNTROWS (
				FILTER (
					FILTER ( VALUES ( dim_article[article_id] ), [Quantités servies] > 0 ),
					[K22 Classe du plat] = "Cheval de labour"
				)
			)
			```
		formatString: #,0
		displayFolder: 8. Menu et marge

	measure 'K22 Nombre d''énigmes' = ```
			COUNTROWS (
				FILTER (
					FILTER ( VALUES ( dim_article[article_id] ), [Quantités servies] > 0 ),
					[K22 Classe du plat] = "Énigme"
				)
			)
			```
		formatString: #,0
		displayFolder: 8. Menu et marge

	measure 'K22 Nombre de poids morts' = ```
			COUNTROWS (
				FILTER (
					FILTER ( VALUES ( dim_article[article_id] ), [Quantités servies] > 0 ),
					[K22 Classe du plat] = "Poids mort"
				)
			)
			```
		formatString: #,0
		displayFolder: 8. Menu et marge

	measure 'Part des commandes du soir' = ```
			DIVIDE (
				CALCULATE ( [Commandes servies], fait_commande[heure] >= 19 || fait_commande[heure] < 2 ),
				[Commandes servies]
			)
			```
		formatString: 0.0 %
		displayFolder: 9. Saisonnalité

	measure 'K23 Part du soir en Ramadan' = CALCULATE ( [Part des commandes du soir], dim_date[est_ramadan] = TRUE () )
		formatString: 0.0 %
		displayFolder: 9. Saisonnalité

	measure 'K23 Part du soir hors Ramadan' = CALCULATE ( [Part des commandes du soir], dim_date[est_ramadan] = FALSE () )
		formatString: 0.0 %
		displayFolder: 9. Saisonnalité

	measure 'K23 Commandes par jour en Ramadan' = CALCULATE ( [Commandes servies par jour], dim_date[est_ramadan] = TRUE () )
		formatString: #,0.0
		displayFolder: 9. Saisonnalité

	measure 'K23 Commandes par jour hors Ramadan' = CALCULATE ( [Commandes servies par jour], dim_date[est_ramadan] = FALSE () )
		formatString: #,0.0
		displayFolder: 9. Saisonnalité

	measure 'K02 MRR A-1' = ```
			VAR m = EDATE ( MAX ( dim_date[premier_jour_mois] ), -12 )
			RETURN
				CALCULATE ( SUM ( fait_abonnement_mensuel[mrr_ht] ), REMOVEFILTERS ( dim_date ), dim_date[premier_jour_mois] = m )
			```
		formatString: #,0
		displayFolder: 1. Croissance

	measure 'Pont MRR valeur' = ```
			VAR a = MAX ( dim_date[annee] )
			VAR depart =
				CALCULATE ( [K02 MRR], REMOVEFILTERS ( dim_date ), dim_date[annee] = a - 1 )
			RETURN
				SWITCH (
					SELECTEDVALUE ( 'Pont MRR'[ordre] ),
					1, IF ( ISFILTERED ( dim_date[annee] ), depart, 0 ),
					2, [K04 MRR nouveau],
					3, [K04 MRR expansion],
					4, [K04 MRR contraction],
					5, [K04 MRR perdu]
				)
			```
		formatString: #,0
		displayFolder: 1. Croissance

	measure 'Texte K01' = FORMAT ( [K01 Établissements actifs], "#,0" )
		displayFolder: 1. Croissance

	measure 'Texte K01 détail' = "au " & FORMAT ( EOMONTH ( MAX ( dim_date[premier_jour_mois] ), 0 ), "dd/MM/yyyy" )
		displayFolder: 1. Croissance

	measure 'Texte K02' = FORMAT ( [K02 MRR], "#,0" ) & " DT HT"
		displayFolder: 1. Croissance

	measure 'Texte K02 détail' = ```
			VAR p = [K02 MRR A-1]
			RETURN
				IF (
					ISBLANK ( p ),
					"A-1 : non disponible",
					"A-1 : " & FORMAT ( p, "#,0" ) & " DT · " & FORMAT ( DIVIDE ( [K02 MRR] - p, p ), "+0.0 %;-0.0 %" )
				)
			```
		displayFolder: 1. Croissance

	measure 'Texte K03' = FORMAT ( [K03 ARR], "#,0" ) & " DT HT"
		displayFolder: 1. Croissance

	measure 'Texte K03 détail' = ```
			VAR p = 12 * [K02 MRR A-1]
			RETURN
				IF (
					p = 0,
					"A-1 : non disponible",
					"A-1 : " & FORMAT ( p, "#,0" ) & " DT · " & FORMAT ( DIVIDE ( [K03 ARR] - p, p ), "+0.0 %;-0.0 %" )
				)
			```
		displayFolder: 1. Croissance

	measure 'Texte K16' = FORMAT ( [K16 Facturé HT], "#,0" ) & " DT HT"
		displayFolder: 1. Croissance

	measure 'Texte K16 détail' = "encaissé : " & FORMAT ( [K16 Encaissé TTC], "#,0" ) & " DT TTC"
		displayFolder: 1. Croissance

	measure 'Texte K17' = FORMAT ( [K17 Taux de factures payées en retard], "0.0 %" )
		displayFolder: 1. Croissance

	measure 'Texte K17 détail' = ```
			VAR p = CALCULATE ( [K17 Taux de factures payées en retard], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			RETURN
				FORMAT ( [K17 Factures impayées], "#,0" ) & " impayées · A-1 : " & IF ( ISBLANK ( p ), "n. d.", FORMAT ( p, "0.0 %" ) )
			```
		displayFolder: 1. Croissance

	measure 'Texte variation MRR' = "Variation nette : " & FORMAT ( [K04 Variation nette du MRR], "+#,0;-#,0" ) & " DT HT"
		displayFolder: 1. Croissance

	measure 'K06 Rétention de cohorte' = ```
			VAR n = SELECTEDVALUE ( 'Mois écoulés'[mois], 12 )
			VAR arrete = CALCULATE ( MAX ( dim_date[date] ), REMOVEFILTERS ( dim_date ) )
			VAR cohorte = FILTER ( dim_etablissement, NOT ISBLANK ( dim_etablissement[date_mise_en_service] ) )
			VAR eligibles = FILTER ( cohorte, EDATE ( dim_etablissement[date_mise_en_service], n ) <= arrete )
			VAR actifs =
				FILTER (
					eligibles,
					ISBLANK ( dim_etablissement[date_resiliation] )
						|| dim_etablissement[date_resiliation] >= EDATE ( dim_etablissement[date_mise_en_service], n )
				)
			RETURN
				IF (
					COUNTROWS ( cohorte ) > 0 && COUNTROWS ( eligibles ) = COUNTROWS ( cohorte ),
					DIVIDE ( COUNTROWS ( actifs ), COUNTROWS ( eligibles ) )
				)
			```
		formatString: 0 %
		displayFolder: 2. Rétention

	measure 'K06 Rétention à 12 mois des cohortes A-1' = ```
			VAR a = MAX ( dim_date[annee] ) - 1
			RETURN
				CALCULATE (
					[K06 Rétention de cohorte],
					'Mois écoulés'[mois] = 12,
					KEEPFILTERS ( FILTER ( ALL ( dim_etablissement[mois_cohorte] ), YEAR ( dim_etablissement[mois_cohorte] ) = a ) )
				)
			```
		formatString: 0.0 %
		displayFolder: 2. Rétention

	measure 'Couleur cohorte' = ```
			VAR r = [K06 Rétention de cohorte]
			RETURN
				SWITCH (
					TRUE (),
					ISBLANK ( r ), BLANK (),
					r >= 0.95, "#1E3A8A",
					r >= 0.8, "#3B5BDB",
					r >= 0.7, "#748FFC",
					r >= 0.6, "#BAC8FF",
					"#E0E7FF"
				)
			```
		displayFolder: 2. Rétention

	measure 'Couleur texte cohorte' = IF ( [K06 Rétention de cohorte] >= 0.8, "#FFFFFF", "#0F172A" )
		displayFolder: 2. Rétention

	measure 'Texte K05' = FORMAT ( [K05 Taux de résiliation mensuel], "0.00 %" )
		displayFolder: 2. Rétention

	measure 'Texte K05 détail' = ```
			VAR p = CALCULATE ( [K05 Taux de résiliation mensuel], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			RETURN
				"moyenne pondérée · A-1 : " & IF ( ISBLANK ( p ), "n. d.", FORMAT ( p, "0.00 %" ) )
			```
		displayFolder: 2. Rétention

	measure 'Texte résiliations' = FORMAT ( [Résiliations], "#,0" )
		displayFolder: 2. Rétention

	measure 'Texte résiliations détail' = "du " & FORMAT ( MIN ( dim_date[date] ), "dd/MM/yyyy" ) & " au " & FORMAT ( MAX ( dim_date[date] ), "dd/MM/yyyy" )
		displayFolder: 2. Rétention

	measure 'Texte K06' = ```
			VAR r = [K06 Rétention à 12 mois des cohortes A-1]
			RETURN IF ( ISBLANK ( r ), "n. d.", FORMAT ( r, "0.0 %" ) )
			```
		displayFolder: 2. Rétention

	measure 'Texte K06 détail' = "cohortes " & ( MAX ( dim_date[annee] ) - 1 )
		displayFolder: 2. Rétention

	measure 'Texte MRR perdu' = FORMAT ( -[K04 MRR perdu], "#,0" ) & " DT HT"
		displayFolder: 2. Rétention

	measure 'Texte MRR perdu détail' = "somme des pertes du K04"
		displayFolder: 2. Rétention

	measure 'Texte moyenne K05' = "Moyenne de la période : " & FORMAT ( [K05 Taux de résiliation mensuel], "0.00 %" )
		displayFolder: 2. Rétention

	measure Clics = SUM ( fait_marketing[clics] )
		formatString: #,0
		displayFolder: 3. Acquisition

	measure 'Signatures (campagne)' = CALCULATE ( [Signatures], TREATAS ( VALUES ( fait_marketing[campagne_id] ), fait_prospect[campagne_id] ) )
		formatString: #,0
		displayFolder: 3. Acquisition

	measure 'K10 Valeur vie client par canal' = CALCULATE ( [K10 Valeur vie client], TREATAS ( VALUES ( dim_canal[canal_id] ), dim_etablissement[canal_id] ) )
		formatString: #,0
		displayFolder: 3. Acquisition

	measure 'Prospects par étape' = ```
			SWITCH (
				SELECTEDVALUE ( 'Étapes commerciales'[ordre] ),
				1, [Prospects],
				2, CALCULATE ( [Prospects], fait_prospect[statut_prospect] IN { "en_cours", "converti" } ),
				3, CALCULATE ( [Prospects], fait_prospect[statut_prospect] = "converti" )
			)
			```
		formatString: #,0
		displayFolder: 3. Acquisition

	measure 'Couleur CAC' = ```
			VAR c = [K09 CAC]
			VAR canaux = FILTER ( ALLSELECTED ( dim_canal[nom_canal] ), NOT ISBLANK ( [K09 CAC] ) )
			VAR mini = MINX ( canaux, [K09 CAC] )
			VAR maxi = MAXX ( canaux, [K09 CAC] )
			RETURN SWITCH ( TRUE (), c = mini, "#1D4ED8", c = maxi, "#C2410C", "#CBD5E1" )
			```
		displayFolder: 3. Acquisition

