	measure 'Texte commandes par jour' = FORMAT ( [K23 Commandes par jour hors Ramadan], "#,0.00" ) & " → " & FORMAT ( [K23 Commandes par jour en Ramadan], "#,0.00" )
		displayFolder: 9. Saisonnalité
