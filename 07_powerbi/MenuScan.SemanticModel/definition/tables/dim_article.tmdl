	column taux_cout
		dataType: decimal
		formatString: #,0.000
		summarizeBy: none
		sourceColumn: taux_cout

	column statut_taux_cout
		dataType: string
		summarizeBy: none
		sourceColumn: statut_taux_cout

	partition dim_article = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "dim_article"]}[Data]
				in
					Donnees
