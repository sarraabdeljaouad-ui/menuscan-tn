	column article_id
		dataType: string
		summarizeBy: none
		sourceColumn: article_id

	column etablissement_id
		dataType: string
		summarizeBy: none
		sourceColumn: etablissement_id

	column categorie_id
		dataType: string
		summarizeBy: none
		sourceColumn: categorie_id

	column nom_categorie
		dataType: string
		summarizeBy: none
		sourceColumn: nom_categorie

	column nom_article
		dataType: string
		summarizeBy: none
		sourceColumn: nom_article

	column statut_article
		dataType: string
		summarizeBy: none
		sourceColumn: statut_article

	column date_ajout
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date_ajout

	column date_retrait
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date_retrait

	column valide_du
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: valide_du

	column valide_au
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: valide_au

	column prix_ttc
		dataType: decimal
		formatString: #,0.000
		summarizeBy: none
		sourceColumn: prix_ttc

	column motif_changement
		dataType: string
		summarizeBy: none
		sourceColumn: motif_changement

	column est_prix_actuel
		dataType: boolean
		summarizeBy: none
		sourceColumn: est_prix_actuel

	column prix_precedent
		dataType: decimal
		formatString: #,0.000
		summarizeBy: none
		sourceColumn: prix_precedent

	column debut_version_precedente
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
