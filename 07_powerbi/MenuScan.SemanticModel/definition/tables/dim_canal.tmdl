table dim_canal

	column canal_id
		dataType: string
		summarizeBy: none
		sourceColumn: canal_id

	column nom_canal
		dataType: string
		summarizeBy: none
		sourceColumn: nom_canal

	column type_canal
		dataType: string
		summarizeBy: none
		sourceColumn: type_canal

	column taux_conversion_cible
		dataType: decimal
		formatString: #,0.000
		summarizeBy: none
		sourceColumn: taux_conversion_cible

	partition dim_canal = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "dim_canal"]}[Data]
				in
					Donnees
