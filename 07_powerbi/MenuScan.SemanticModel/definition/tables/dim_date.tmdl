table dim_date
	dataCategory: Time

	column date_id
		dataType: int64
		summarizeBy: none
		sourceColumn: date_id

	column date
		dataType: dateTime
		isKey
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date

	column annee
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: annee

	column trimestre
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: trimestre

	column mois
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: mois

	column nom_mois
		dataType: string
		summarizeBy: none
		sourceColumn: nom_mois
		sortByColumn: mois

	column premier_jour_mois
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: premier_jour_mois

	column annee_mois
		dataType: string
		summarizeBy: none
		sourceColumn: annee_mois

	column semaine_iso
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: semaine_iso

	column jour_semaine
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: jour_semaine

	column nom_jour
		dataType: string
		summarizeBy: none
		sourceColumn: nom_jour
		sortByColumn: jour_semaine

	column est_weekend
		dataType: boolean
		summarizeBy: none
		sourceColumn: est_weekend

	column est_jour_ferie
		dataType: boolean
		summarizeBy: none
		sourceColumn: est_jour_ferie

	column nom_jour_ferie
		dataType: string
		summarizeBy: none
		sourceColumn: nom_jour_ferie

	column est_ramadan
		dataType: boolean
		summarizeBy: none
		sourceColumn: est_ramadan

	column periode_activite
		dataType: string
		summarizeBy: none
		sourceColumn: periode_activite

	column jour_court = UPPER ( LEFT ( dim_date[nom_jour], 1 ) ) & MID ( dim_date[nom_jour], 2, 2 )
		dataType: string
		summarizeBy: none
		sortByColumn: jour_semaine

	column debut_semaine = dim_date[date] - WEEKDAY ( dim_date[date], 2 ) + 1
		dataType: dateTime
		formatString: dd/MM/yyyy
		summarizeBy: none

	partition dim_date = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "dim_date"]}[Data]
				in
					Donnees
