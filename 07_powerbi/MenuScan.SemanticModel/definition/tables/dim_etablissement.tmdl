table dim_etablissement

	column etablissement_id
		dataType: string
		summarizeBy: none
		sourceColumn: etablissement_id

	column nom_etablissement
		dataType: string
		summarizeBy: none
		sourceColumn: nom_etablissement

	column type_etablissement
		dataType: string
		summarizeBy: none
		sourceColumn: type_etablissement

	column ville_id
		dataType: string
		summarizeBy: none
		sourceColumn: ville_id

	column ville
		dataType: string
		summarizeBy: none
		sourceColumn: ville

	column gouvernorat
		dataType: string
		summarizeBy: none
		sourceColumn: gouvernorat

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column canal_id
		dataType: string
		summarizeBy: none
		sourceColumn: canal_id

	column nom_canal
		dataType: string
		summarizeBy: none
		sourceColumn: nom_canal

	column type_canal
		dataType: string
		summarizeBy: none
		sourceColumn: type_canal

	column campagne_id
		dataType: string
		summarizeBy: none
		sourceColumn: campagne_id

	column prospect_id
		dataType: string
		summarizeBy: none
		sourceColumn: prospect_id

	column date_signature
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date_signature

	column date_mise_en_service
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date_mise_en_service

	column mois_cohorte
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: mois_cohorte

	column nb_tables
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: nb_tables

	column formule_initiale_id
		dataType: string
		summarizeBy: none
		sourceColumn: formule_initiale_id

	column formule_initiale
		dataType: string
		summarizeBy: none
		sourceColumn: formule_initiale

	column formule_actuelle_id
		dataType: string
		summarizeBy: none
		sourceColumn: formule_actuelle_id

	column formule_actuelle
		dataType: string
		summarizeBy: none
		sourceColumn: formule_actuelle

	column periodicite_facturation
		dataType: string
		summarizeBy: none
		sourceColumn: periodicite_facturation

	column statut_etablissement
		dataType: string
		summarizeBy: none
		sourceColumn: statut_etablissement

	column est_actif
		dataType: boolean
		summarizeBy: none
		sourceColumn: est_actif

	column date_resiliation
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date_resiliation

	column motif_resiliation
		dataType: string
		summarizeBy: none
		sourceColumn: motif_resiliation

	column etablissement = dim_etablissement[nom_etablissement] & " · " & dim_etablissement[ville]
		dataType: string
		summarizeBy: none

	column trimestre_cohorte = "T" & QUARTER ( dim_etablissement[mois_cohorte] ) & " " & YEAR ( dim_etablissement[mois_cohorte] )
		dataType: string
		summarizeBy: none
		sortByColumn: ordre_cohorte

	column ordre_cohorte = YEAR ( dim_etablissement[mois_cohorte] ) * 10 + QUARTER ( dim_etablissement[mois_cohorte] )
		dataType: int64
		formatString: 0
		summarizeBy: none

	partition dim_etablissement = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "dim_etablissement"]}[Data]
				in
					Donnees
