table dim_formule

	column formule_id
		dataType: string
		summarizeBy: none
		sourceColumn: formule_id

	column nom_formule
		dataType: string
		summarizeBy: none
		sourceColumn: nom_formule

	column prix_mensuel_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: none
		sourceColumn: prix_mensuel_ht

	column prix_annuel_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: none
		sourceColumn: prix_annuel_ht

	column frais_mise_en_place_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: none
		sourceColumn: frais_mise_en_place_ht

	column inclut_commande
		dataType: boolean
		summarizeBy: none
		sourceColumn: inclut_commande

	column inclut_statistiques
		dataType: boolean
		summarizeBy: none
		sourceColumn: inclut_statistiques

	column description
		dataType: string
		summarizeBy: none
		sourceColumn: description

	partition dim_formule = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "dim_formule"]}[Data]
				in
					Donnees
