table dim_heure

	column heure
		dataType: int64
		summarizeBy: none
		sourceColumn: heure

	column libelle
		dataType: string
		summarizeBy: none
		sourceColumn: libelle
		sortByColumn: heure

	column moment_journee
		dataType: string
		summarizeBy: none
		sourceColumn: moment_journee

	column ordre_journee = MOD ( dim_heure[heure] - 6 + 24, 24 )
		dataType: int64
		formatString: 0
		summarizeBy: none

	column libelle_court = FORMAT ( dim_heure[heure], "0" ) & " h"
		dataType: string
		summarizeBy: none
		sortByColumn: ordre_journee

	partition dim_heure = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "dim_heure"]}[Data]
				in
					Donnees
