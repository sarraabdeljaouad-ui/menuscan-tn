table dim_table

	column table_id
		dataType: string
		summarizeBy: none
		sourceColumn: table_id

	column etablissement_id
		dataType: string
		summarizeBy: none
		sourceColumn: etablissement_id

	column numero_table
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: numero_table

	column zone
		dataType: string
		summarizeBy: none
		sourceColumn: zone

	column capacite
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: capacite

	column qr_code_id
		dataType: string
		summarizeBy: none
		sourceColumn: qr_code_id

	column date_installation
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date_installation

	column libelle_table = "Table " & dim_table[numero_table] & " · " & dim_table[zone]
		dataType: string
		summarizeBy: none

	partition dim_table = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "dim_table"]}[Data]
				in
					Donnees
