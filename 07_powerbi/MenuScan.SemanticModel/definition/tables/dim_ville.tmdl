table dim_ville

	column ville_id
		dataType: string
		summarizeBy: none
		sourceColumn: ville_id

	column ville
		dataType: string
		summarizeBy: none
		sourceColumn: ville

	column gouvernorat
		dataType: string
		summarizeBy: none
		sourceColumn: gouvernorat

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column est_cotiere
		dataType: boolean
		summarizeBy: none
		sourceColumn: est_cotiere

	column poids_marche
		dataType: decimal
		formatString: #,0.000
		summarizeBy: none
		sourceColumn: poids_marche

	column date_ouverture_commerciale
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date_ouverture_commerciale

	partition dim_ville = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "dim_ville"]}[Data]
				in
					Donnees
