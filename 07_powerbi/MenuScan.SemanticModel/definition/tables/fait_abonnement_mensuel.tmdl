table fait_abonnement_mensuel

	column etablissement_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: etablissement_id

	column mois
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: mois

	column date_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_id

	column abonnement_id
		dataType: string
		summarizeBy: none
		sourceColumn: abonnement_id

	column formule_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: formule_id

	column periodicite
		dataType: string
		summarizeBy: none
		sourceColumn: periodicite

	column mrr_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: mrr_ht

	column mrr_precedent_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: mrr_precedent_ht

	column variation_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: variation_ht

	column mouvement
		dataType: string
		summarizeBy: none
		sourceColumn: mouvement

	column mrr_nouveau_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: mrr_nouveau_ht

	column mrr_expansion_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: mrr_expansion_ht

	column mrr_contraction_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: mrr_contraction_ht

	column mrr_resiliation_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: mrr_resiliation_ht

	column est_abonne
		dataType: boolean
		summarizeBy: none
		sourceColumn: est_abonne

	partition fait_abonnement_mensuel = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "fait_abonnement_mensuel"]}[Data]
				in
					Donnees
