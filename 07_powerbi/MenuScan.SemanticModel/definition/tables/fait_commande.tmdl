table fait_commande

	column commande_id
		dataType: string
		summarizeBy: none
		sourceColumn: commande_id

	column session_id
		dataType: string
		summarizeBy: none
		sourceColumn: session_id

	column etablissement_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: etablissement_id

	column table_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: table_id

	column date_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_id

	column heure
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: heure

	column date_heure_commande
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: date_heure_commande

	column date_heure_service
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: date_heure_service

	column delai_service_minutes
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: delai_service_minutes

	column statut_commande
		dataType: string
		summarizeBy: none
		sourceColumn: statut_commande

	column est_servie
		dataType: boolean
		summarizeBy: none
		sourceColumn: est_servie

	column mode_reglement
		dataType: string
		summarizeBy: none
		sourceColumn: mode_reglement

	column motif_annulation
		dataType: string
		summarizeBy: none
		sourceColumn: motif_annulation

	column nb_lignes
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: nb_lignes

	column nb_articles
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: nb_articles

	column montant_total_ttc
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: montant_total_ttc

	column lignes_completes
		dataType: boolean
		summarizeBy: none
		sourceColumn: lignes_completes

	partition fait_commande = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "fait_commande"]}[Data]
				in
					Donnees
