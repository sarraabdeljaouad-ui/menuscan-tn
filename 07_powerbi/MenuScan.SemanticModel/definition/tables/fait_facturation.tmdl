table fait_facturation

	column facture_id
		dataType: string
		summarizeBy: none
		sourceColumn: facture_id

	column etablissement_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: etablissement_id

	column abonnement_id
		dataType: string
		summarizeBy: none
		sourceColumn: abonnement_id

	column formule_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: formule_id

	column type_facture
		dataType: string
		summarizeBy: none
		sourceColumn: type_facture

	column date_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_id

	column date_emission
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date_emission

	column date_echeance
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date_echeance

	column periode_debut
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: periode_debut

	column periode_fin
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: periode_fin

	column montant_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: montant_ht

	column remise_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: remise_ht

	column motif_remise
		dataType: string
		summarizeBy: none
		sourceColumn: motif_remise

	column montant_net_ht
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: montant_net_ht

	column montant_tva
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: montant_tva

	column montant_ttc
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: montant_ttc

	column montant_encaisse_ttc
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: montant_encaisse_ttc

	column date_paiement
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: date_paiement

	column mode_paiement
		dataType: string
		summarizeBy: none
		sourceColumn: mode_paiement

	column nb_tentatives
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: nb_tentatives

	column nb_echecs
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: nb_echecs

	column jours_retard
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: jours_retard

	column statut_facture
		dataType: string
		summarizeBy: none
		sourceColumn: statut_facture

	partition fait_facturation = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "fait_facturation"]}[Data]
				in
					Donnees
