table fait_marketing

	column depense_id
		dataType: string
		summarizeBy: none
		sourceColumn: depense_id

	column campagne_id
		dataType: string
		summarizeBy: none
		sourceColumn: campagne_id

	column canal_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: canal_id

	column ville_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: ville_id

	column date_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_id

	column depense_ttc
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: depense_ttc

	column impressions
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: impressions

	column clics
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: clics

	column nb_prospects
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: nb_prospects

	partition fait_marketing = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "fait_marketing"]}[Data]
				in
					Donnees
