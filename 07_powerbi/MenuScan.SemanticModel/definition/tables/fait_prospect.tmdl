table fait_prospect

	column prospect_id
		dataType: string
		summarizeBy: none
		sourceColumn: prospect_id

	column canal_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: canal_id

	column campagne_id
		dataType: string
		summarizeBy: none
		sourceColumn: campagne_id

	column ville_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: ville_id

	column type_etablissement
		dataType: string
		summarizeBy: none
		sourceColumn: type_etablissement

	column date_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_id

	column date_contact
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date_contact

	column date_conversion
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: date_conversion

	column statut_prospect
		dataType: string
		summarizeBy: none
		sourceColumn: statut_prospect

	column est_converti
		dataType: boolean
		summarizeBy: none
		sourceColumn: est_converti

	column delai_conversion_jours
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: delai_conversion_jours

	column etablissement_id
		dataType: string
		summarizeBy: none
		sourceColumn: etablissement_id

	column parrain_etablissement_id
		dataType: string
		summarizeBy: none
		sourceColumn: parrain_etablissement_id

	column motif_perte
		dataType: string
		summarizeBy: none
		sourceColumn: motif_perte

	partition fait_prospect = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "fait_prospect"]}[Data]
				in
					Donnees
