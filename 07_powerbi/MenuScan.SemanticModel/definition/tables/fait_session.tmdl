table fait_session

	column session_id
		dataType: string
		summarizeBy: none
		sourceColumn: session_id

	column etablissement_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: etablissement_id

	column table_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: table_id

	column formule_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: formule_id

	column date_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_id

	column heure
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: heure

	column debut_session
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: debut_session

	column fin_session
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: fin_session

	column duree_secondes
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: duree_secondes

	column appareil
		dataType: string
		summarizeBy: none
		sourceColumn: appareil

	column langue
		dataType: string
		summarizeBy: none
		sourceColumn: langue

	column nb_evenements
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: nb_evenements

	column nb_articles_vus
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: nb_articles_vus

	column a_vu_menu
		dataType: boolean
		summarizeBy: none
		sourceColumn: a_vu_menu

	column a_vu_article
		dataType: boolean
		summarizeBy: none
		sourceColumn: a_vu_article

	column a_ajoute_panier
		dataType: boolean
		summarizeBy: none
		sourceColumn: a_ajoute_panier

	column a_commande
		dataType: boolean
		summarizeBy: none
		sourceColumn: a_commande

	column commande_id
		dataType: string
		summarizeBy: none
		sourceColumn: commande_id

	column commande_non_recue
		dataType: boolean
		summarizeBy: none
		sourceColumn: commande_non_recue

	partition fait_session = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "fait_session"]}[Data]
				in
					Donnees
