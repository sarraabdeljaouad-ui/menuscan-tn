table fait_ticket_support

	column ticket_id
		dataType: string
		summarizeBy: none
		sourceColumn: ticket_id

	column etablissement_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: etablissement_id

	column date_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_id

	column date_ouverture
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: date_ouverture

	column date_resolution
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: date_resolution

	column categorie
		dataType: string
		summarizeBy: none
		sourceColumn: categorie

	column canal_contact
		dataType: string
		summarizeBy: none
		sourceColumn: canal_contact

	column statut_ticket
		dataType: string
		summarizeBy: none
		sourceColumn: statut_ticket

	column delai_resolution_heures
		dataType: decimal
		formatString: #,0.000
		summarizeBy: sum
		sourceColumn: delai_resolution_heures

	column note_satisfaction
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: note_satisfaction

	partition fait_ticket_support = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "fait_ticket_support"]}[Data]
				in
					Donnees
