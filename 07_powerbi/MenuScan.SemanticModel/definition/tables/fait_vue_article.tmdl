table fait_vue_article

	column etablissement_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: etablissement_id

	column article_id
		dataType: string
		summarizeBy: none
		sourceColumn: article_id

	column prix_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: prix_id

	column date_id
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_id

	column heure
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: heure

	column nb_vues
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: nb_vues

	column nb_sessions
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: nb_sessions

	partition fait_vue_article = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(Serveur, Base),
					Donnees = Source{[Schema = "marts", Item = "fait_vue_article"]}[Data]
				in
					Donnees
