table 'Étapes commerciales'

	column etape
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [etape]
		sortByColumn: ordre

	column ordre
		dataType: int64
		summarizeBy: none
		isNameInferred
		sourceColumn: [ordre]

	partition 'Étapes commerciales' = calculated
		mode: import
		source = DATATABLE ( "etape", STRING, "ordre", INTEGER, { { "Prospects contactés", 1 }, { "En cours ou signés", 2 }, { "Signés", 3 } } )
