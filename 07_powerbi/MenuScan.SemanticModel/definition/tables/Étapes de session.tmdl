table 'Étapes de session'

	column etape
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [etape]
		sortByColumn: ordre

	column ordre
		dataType: int64
		summarizeBy: none
		isNameInferred
		sourceColumn: [ordre]

	partition 'Étapes de session' = calculated
		mode: import
		source = DATATABLE ( "etape", STRING, "ordre", INTEGER, { { "Scans", 1 }, { "Panier", 2 }, { "Commande", 3 } } )
